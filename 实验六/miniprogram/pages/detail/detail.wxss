/* pages/detail/detail.wxss */

.big-pic {
  width: 100%;
  display: block;
  background: #000;
}

.desc-box {
  background: #fff;
  padding: 30rpx 30rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.author-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fff;
  padding: 24rpx 30rpx;
  margin-top: 16rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}

.author-info {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.nickname {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.time {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 6rpx;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 20rpx 0;
}

.btn-row {
  display: flex;
  flex-direction: row;
  padding: 0 30rpx;
}

.btn-row .btn {
  flex: 1;
  margin: 0 10rpx;
}

.btn {
  background: #fff;
  color: #4a90d9;
  font-size: 30rpx;
  border-radius: 12rpx;
  padding: 22rpx 0;
  margin: 16rpx 30rpx;
  line-height: 1.4;
  border: 1rpx solid #d6e6f7;
}

.btn:active {
  background: #f2f7fc;
}

.btn-danger {
  color: #e64340;
  border-color: #f5c6c4;
}

.btn-danger:active {
  background: #fdecec;
}
