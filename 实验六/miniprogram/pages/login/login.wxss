/* pages/login/login.wxss —— 清爽渐变风格登录页 */

.login-page {
  min-height: 100vh;
  padding: 0 48rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #eaf3ff 0%, #f6f6f6 42%);
}

/* ========== 品牌区 ========== */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 56rpx;
}

.logo-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 8rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(74, 144, 217, 0.25);
  box-sizing: border-box;
}

.logo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #222;
  margin-top: 32rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 14rpx;
}

/* ========== 资料卡 ========== */
.card {
  width: 100%;
  background: #fff;
  border-radius: 28rpx;
  padding: 56rpx 48rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  width: 168rpx;
  height: 168rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #f2f2f2;
  position: relative;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn .avatar {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  display: block;
  flex-shrink: 0;
}

.avatar-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.16);
}

.avatar-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}

/* ========== 昵称输入 ========== */
.field {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 44rpx;
  padding: 0 24rpx 20rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eee;
}

.field .label {
  width: 100rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.field .input {
  flex: 1;
  font-size: 30rpx;
  color: #222;
  height: 48rpx;
  line-height: 48rpx;
}

.field .ph {
  color: #c4c4c4;
  font-size: 28rpx;
}

.tip-row {
  margin-top: 24rpx;
}

.tip-link {
  font-size: 24rpx;
  color: #4a90d9;
}

/* ========== 主按钮 ========== */
.primary-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 56rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #4a90d9, #6fb1e7);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  padding: 0;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 217, 0.35);
}

.primary-btn:active {
  opacity: 0.9;
}

/* ========== 底部链接 ========== */
.link-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 32rpx;
}

.link-row .link {
  font-size: 26rpx;
  color: #888;
  padding: 0 24rpx;
}

.link-row .link.danger {
  color: #e64340;
}

.footnote {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
  margin-top: 48rpx;
  line-height: 1.6;
}
