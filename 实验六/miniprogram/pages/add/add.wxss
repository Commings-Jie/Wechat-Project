/* pages/add/add.wxss */

.section {
  background: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

/* ========== 描述输入 ========== */
.desc-input {
  font-size: 28rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

/* ========== 九宫格 ========== */
.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.grid-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f5f5f5;
}

/* 每行三个：第 3n 个去掉右边距 */
.grid-item:nth-child(3n) {
  margin-right: 0;
}

.thumb {
  width: 100%;
  height: 100%;
  display: block;
}

/* 右上角删除按钮 */
.remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 34rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  border-bottom-left-radius: 10rpx;
}

/* 加号按钮 */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccc;
  background: #fafafa;
  box-sizing: border-box;
}

.plus {
  font-size: 70rpx;
  color: #bbb;
  line-height: 1;
}

/* ========== 上传按钮 ========== */
.upload-btn {
  background: #4a90d9;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  margin: 20rpx 30rpx;
  padding: 24rpx 0;
  line-height: 1.4;
}

.upload-btn:active {
  opacity: 0.85;
}

.upload-btn.disabled {
  background: #b8cde3;
}
