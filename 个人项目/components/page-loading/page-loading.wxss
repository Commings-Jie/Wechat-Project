.page-loading {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  overflow: hidden;
  background: #167D8D;
}

.page-loading-image,
.page-loading-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.page-loading-mask {
  background: rgba(18, 74, 81, .34);
}

.page-loading-content {
  position: absolute;
  left: 52rpx;
  right: 52rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  color: #FFFFFF;
}

.page-loading-mark {
  font-size: 20rpx;
  font-weight: 700;
}

.page-loading-title {
  margin-top: 18rpx;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-loading-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.page-loading-dots {
  display: flex;
  margin-top: 36rpx;
}

.page-loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFFFFF;
  animation: loading-pulse 1s ease-in-out infinite;
}

.page-loading-dot + .page-loading-dot { margin-left: 12rpx; }
.dot-two { animation-delay: .15s; }
.dot-three { animation-delay: .3s; }

@keyframes loading-pulse {
  0%, 100% { opacity: .35; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-8rpx); }
}
