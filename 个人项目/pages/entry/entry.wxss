page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #55C8CE;
}

.entry-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.entry-background,
.entry-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.entry-shade {
  background: linear-gradient(180deg, rgba(15, 104, 125, 0) 48%, rgba(14, 104, 112, .12) 68%, rgba(14, 104, 112, .24) 100%);
}

.entry-brand {
  position: absolute;
  top: 61%;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #FFFFFF;
  transition: opacity .2s ease, transform .2s ease;
}

.entry-brand-entering {
  opacity: .55;
  transform: scale(.98);
}

.entry-title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.25;
  text-shadow: 0 3rpx 12rpx rgba(17, 105, 112, .28);
}

.entry-slogan {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, .9);
  font-size: 25rpx;
  line-height: 1.5;
  text-shadow: 0 2rpx 8rpx rgba(17, 105, 112, .24);
}

.entry-line {
  width: 54rpx;
  height: 5rpx;
  margin-top: 24rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, .9);
}
