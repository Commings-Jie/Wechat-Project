page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.home-shell {
  padding-bottom: 80rpx;
}

/* 1. 今日天空气象馆 Hero 卡片 */
.sky-hero-panel {
  position: relative;
  overflow: hidden;
  min-height: 440rpx;
  border-radius: 36rpx;
  color: #FFFFFF;
  box-shadow: 0 16rpx 44rpx rgba(22, 125, 141, 0.18);
  background: #6FA4AA;
}

.sky-hero-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.sky-hero-glow {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  background: linear-gradient(135deg, rgba(16, 42, 50, 0.72) 0%, rgba(18, 48, 56, 0.35) 55%, rgba(18, 48, 56, 0.12) 100%);
}

.sky-hero-inner {
  position: relative;
  z-index: 2;
  padding: 36rpx 34rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 440rpx;
  box-sizing: border-box;
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  transition: all 0.2s ease;
}

.hero-badge.badge-hover {
  background: rgba(255, 255, 255, 0.32);
  transform: scale(0.96);
}

.refresh-hint-icon {
  font-size: 18rpx;
  margin-left: 8rpx;
  opacity: 0.75;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4ADE80;
  margin-right: 10rpx;
  box-shadow: 0 0 8rpx #4ADE80;
}
.live-dot.offline {
  background: #FBBF24;
  box-shadow: 0 0 8rpx #FBBF24;
}

.hero-loc {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.hero-date-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.hero-center {
  margin-top: 14rpx;
}

.hero-weather-title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.hero-reading {
  display: flex;
  align-items: flex-end;
  margin-top: 6rpx;
}

.hero-temp {
  font-size: 86rpx;
  line-height: 0.95;
  font-weight: 200;
  letter-spacing: -2rpx;
}

.hero-meta {
  margin-left: 20rpx;
  margin-bottom: 6rpx;
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.6;
}

.hero-subline {
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.hero-humidity {
  margin-left: 4rpx;
  opacity: 0.92;
}

.hero-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.hero-greeting {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
}
.sparkle-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

.hero-record-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.15s ease, background 0.15s ease;
}

.hero-record-pill:active {
  transform: scale(0.94);
  background: rgba(255, 255, 255, 0.45);
}

.plus-icon {
  margin-right: 6rpx;
  font-size: 28rpx;
}

/* 1-B. 未开启定位或拒绝授权时的手帐风格卡片 */
.sky-hero-denied-panel {
  background: linear-gradient(135deg, #446D74 0%, #2D5259 60%, #1D3B40 100%);
  box-shadow: 0 16rpx 40rpx rgba(29, 59, 64, 0.22);
}

.denied-glow {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.15) 0%, transparent 60%);
}

.denied-inner {
  justify-content: space-between;
}

.denied-badge {
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.denied-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 24rpx 10rpx 20rpx;
}

.denied-icon {
  font-size: 64rpx;
  line-height: 1;
  margin-bottom: 12rpx;
  filter: drop-shadow(0 4rpx 10rpx rgba(0, 0, 0, 0.15));
}

.denied-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #FFFFFF;
}

.denied-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 10rpx;
  max-width: 520rpx;
  line-height: 1.5;
}

.denied-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.hero-setting-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  transition: transform 0.15s ease, background 0.15s ease;
}

.hero-setting-pill:active {
  transform: scale(0.94);
  background: rgba(255, 255, 255, 0.28);
}

.setting-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

.sky-hero-loading-panel {
  background: linear-gradient(135deg, #537B82 0%, #355B63 100%);
}

.loading-inner {
  justify-content: space-between;
}

.loading-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 30rpx 0;
}

.loading-subtext {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
}

/* 2. 手帐打卡 Bento 便签栏 */
.bento-board {
  display: flex;
  gap: 20rpx;
  margin-top: 26rpx;
}

.bento-sticky {
  flex: 1;
  position: relative;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 26rpx 24rpx 22rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 30rpx rgba(22, 60, 68, 0.05);
  border: 1rpx solid rgba(226, 237, 238, 0.85);
  overflow: hidden;
}

.streak-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #F5FBFB 100%);
}

.mood-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FDF8F3 100%);
}

.sticky-pin {
  position: absolute;
  top: 14rpx;
  left: 20rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(22, 125, 141, 0.25);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
}

.pin-right {
  left: auto;
  right: 20rpx;
  background: rgba(244, 162, 54, 0.3);
}

.sticky-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sticky-label {
  font-size: 23rpx;
  color: #6C858A;
  font-weight: 600;
}

.sticky-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  background: rgba(23, 131, 148, 0.1);
  color: #178394;
  border-radius: 6rpx;
  font-weight: 700;
}

.mood-symbol-pill {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  background: rgba(244, 162, 54, 0.12);
  color: #B56D0E;
  border-radius: 12rpx;
  font-weight: 700;
}

.sticky-body {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.sticky-number {
  font-size: 54rpx;
  font-weight: 800;
  color: #153940;
  line-height: 1;
}

.sticky-unit {
  font-size: 22rpx;
  color: #8CABB0;
  margin-left: 8rpx;
  font-weight: 600;
}

.sticky-footer {
  margin-top: 14rpx;
}

.sticky-tip {
  font-size: 20rpx;
  color: #8CA0A3;
  line-height: 1.3;
}

/* 3. 和纸便签入口条 */
.interactive-strip-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.past-picker-wrap {
  flex: 1;
}

.washi-strip {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(220, 235, 236, 0.9);
  box-shadow: 0 4rpx 16rpx rgba(22, 60, 68, 0.04);
}

.strip-icon-circle {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E8F5F4;
  color: #178394;
  font-size: 28rpx;
  flex-shrink: 0;
}

.strip-icon-circle.past {
  background: #FEF3E2;
  color: #D97706;
}

.strip-content {
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
}

.strip-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #153940;
}

.strip-desc {
  font-size: 20rpx;
  color: #8CA0A3;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.strip-arrow {
  color: #A3B5B8;
  font-size: 36rpx;
  margin-left: 8rpx;
}

/* 4. 生活手帐拍立得回忆流 */
.journal-stream {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}

.journal-entry-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(21, 57, 64, 0.05);
  border: 1rpx solid rgba(226, 237, 238, 0.85);
  position: relative;
  overflow: hidden;
}

/* 玻璃天气珠 */
.entry-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.mood-orb {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #EDF7F6;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(22, 125, 141, 0.12);
}

.mood-orb-sunny { background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%); }
.mood-orb-cloudy { background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%); }
.mood-orb-overcast { background: linear-gradient(135deg, #F1F5F9 0%, #E2E8F0 100%); }
.mood-orb-rainy { background: linear-gradient(135deg, #F0F9FF 0%, #E0F2FE 100%); }
.mood-orb-stormy { background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%); }
.mood-orb-rainbow { background: linear-gradient(135deg, #FDF2F8 0%, #FCE7F3 100%); }

.mood-score-capsule {
  margin-top: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #9C7720;
  background: #FEF7E6;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

/* 文本与标签 */
.entry-center {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.entry-top {
  display: flex;
  align-items: baseline;
}

.entry-weather-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #153940;
}

.entry-date {
  font-size: 22rpx;
  color: #8FA4A7;
  margin-left: 14rpx;
}

.entry-quote {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #38555A;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.entry-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

/* 拍立得相框与扇形层叠多图展台 */
.entry-right {
  margin-left: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.polaroid-fan-stack {
  position: relative;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.polaroid-fan-stack.count-1 {
  width: 96rpx;
}

.polaroid-fan-stack.count-2 {
  width: 126rpx;
}

.polaroid-fan-stack.count-3 {
  width: 144rpx;
}

.fan-card {
  position: absolute;
  width: 82rpx;
  height: 96rpx;
  background: #FFFFFF;
  padding: 5rpx 5rpx 14rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 14rpx rgba(22, 60, 68, 0.14);
  border: 1rpx solid rgba(220, 232, 233, 0.9);
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
  transform-origin: 50% 90%;
}

.fan-img {
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
  display: block;
}

/* 1张照片：微倾角经典单张手帐拍立得 */
.count-1 .fan-card-0 {
  position: relative;
  transform: rotate(2deg);
  z-index: 1;
}

/* 2张照片：双叶扇形对角错落展开 */
.count-2 .fan-card-0 {
  transform: rotate(-9deg) translate(-10rpx, 4rpx);
  z-index: 1;
}
.count-2 .fan-card-1 {
  transform: rotate(8deg) translate(10rpx, -2rpx);
  z-index: 2;
}

/* 3张照片：三叶草扇形优雅展开 */
.count-3 .fan-card-0 {
  transform: rotate(-15deg) translate(-20rpx, 6rpx);
  z-index: 1;
}
.count-3 .fan-card-1 {
  transform: rotate(-1deg) translate(0rpx, -4rpx);
  z-index: 2;
}
.count-3 .fan-card-2 {
  transform: rotate(14deg) translate(20rpx, 4rpx);
  z-index: 3;
}

/* 按压微触感反馈 */
.fan-card:active {
  transform: scale(1.08) translateY(-4rpx) !important;
  z-index: 10 !important;
  box-shadow: 0 8rpx 20rpx rgba(22, 60, 68, 0.24);
}

/* 照片张数角标 */
.fan-count-badge {
  position: absolute;
  right: -6rpx;
  bottom: -4rpx;
  z-index: 15;
  background: linear-gradient(135deg, #178394 0%, #38A3B2 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
  border: 2rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(23, 131, 148, 0.35);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.2;
}

.fan-count-text {
  font-size: 18rpx;
  font-weight: 800;
  display: block;
}

.entry-arrow-wrap {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.entry-arrow {
  color: #B5C4C6;
  font-size: 40rpx;
}

/* 空状态 */
.empty-journal-box {
  padding: 70rpx 40rpx;
  text-align: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx dashed #CFDFDF;
  margin-top: 12rpx;
}

.empty-icon {
  font-size: 56rpx;
}

.empty-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #153940;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8FA4A7;
}

